---
# The checks Numerixx is held to (the same set as FXT): bugs and performance, plus a few modernisations, as
# warnings that fail the run.
#
# Left out on purpose:
#   bugprone-unused-return-value          discarding a result is sometimes the point
#   bugprone-easily-swappable-parameters  (lhs, rhs) and (lo, hi) are often the right signature
#   performance-avoid-endl                examples may flush as they print
#   readability-braces-around-statements  not the style here
#   google-explicit-constructor           implicit conversions are part of the API
#   hicpp-explicit-conversions            likewise
#
# The headers are the library, so they are checked too: HeaderFilterRegex covers include/numerixx, and nothing
# fetched. Run it over Numerixx's own sources, not the dependencies a build fetches:
#
#   run-clang-tidy -p <build> '/(tests|examples|benchmarks)/'
#
# Every line of a `>-` block below must stay indented: a `#` line indented less than the block ends it.
Checks: >-
  -*,
  bugprone-*,
  -bugprone-unused-return-value,
  -bugprone-easily-swappable-parameters,
  performance-*,
  -performance-avoid-endl,
  modernize-use-override,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-use-nullptr,
  modernize-use-using,
  misc-unused-using-decls,
  misc-redundant-expression,
  readability-misleading-indentation

WarningsAsErrors: '*'
HeaderFilterRegex: '.*/include/numerixx/.*'
FormatStyle:     none
